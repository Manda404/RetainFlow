# RetainFlow environment template.
# Copy this file to `.env` for local development and fill secrets locally.

# ---------------------------------------------------------------------------
# Application runtime
# ---------------------------------------------------------------------------

APP_NAME=RetainFlow
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=retainflow.log
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FORMAT_JSON=false

# ---------------------------------------------------------------------------
# PostgreSQL local source system
# ---------------------------------------------------------------------------

RETAINFLOW_POSTGRES_DSN=postgresql://retainflow:retainflow@localhost:55432/retainflow
POSTGRES_DB=retainflow
POSTGRES_USER=retainflow
POSTGRES_PASSWORD=retainflow
POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# Synthetic data generation
# ---------------------------------------------------------------------------

RETAINFLOW_SEED=42
RETAINFLOW_N_CUSTOMERS=10000
RETAINFLOW_CSV_DIR=data/raw/retainflow_csv
RETAINFLOW_HISTORY_START_DATE=2020-01-01
RETAINFLOW_HISTORY_END_DATE=2026-06-30
RETAINFLOW_MODE=reset

# ---------------------------------------------------------------------------
# MLflow local tracking
# ---------------------------------------------------------------------------

MLFLOW_TRACKING_URI=sqlite:////Users/surelmanda/.mlflow/mlflow.db
MLFLOW_ARTIFACT_URI=file:///Users/surelmanda/.mlflow/artifacts

# ---------------------------------------------------------------------------
# API and model serving
# ---------------------------------------------------------------------------

RETAINFLOW_MODEL_NAME=retainflow_churn_catboost
RETAINFLOW_MODEL_API_URL=http://127.0.0.1:8000
RETAINFLOW_API_HOST=127.0.0.1
RETAINFLOW_API_PORT=8000

# ---------------------------------------------------------------------------
# LLM supervisor
# ---------------------------------------------------------------------------

# Groq is the default because it is lightweight and compatible with OpenAI-style chat APIs.
RETAINFLOW_LLM_ENABLED=true
# Enables LLM-written customer explanations. This can send customer evidence to the configured LLM provider.
RETAINFLOW_LLM_REASONING_ENABLED=false
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=15
GROQ_API_KEY=your_groq_api_key_here

# Optional: create an OpenAI account and fill this if you want LLM_PROVIDER=openai.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings and optional external RAG services
# ---------------------------------------------------------------------------

RETAINFLOW_RAG_DOCS_DIR=data/docs/strategy_marketing

# Optional providers for future embedding/reranking improvements.
GOOGLE_API_KEY=your_google_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1800
CHUNK_OVERLAP=100
MAX_RAG_CONTEXT_CHARS=4000
MAX_RAG_DOCUMENTS=5

# Pinecone is optional. Use it only if you later replace the local TF-IDF RAG with vector search.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_SERVERLESS_REGION=us-east-1
PINECONE_INDEX_NAME=retainflow-strategy
PINECONE_DIMENSION=3072
PINECONE_METRIC=dotproduct

# ---------------------------------------------------------------------------
# Optional observability
# ---------------------------------------------------------------------------

# Langfuse is not required to run RetainFlow today. Set LANGFUSE_ENABLED=true after integration.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_ENV=development
LANGFUSE_USER_ID=retainflow-local

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

MAX_USER_MESSAGE_CHARS=8000

# Optional: create a strong random secret if you later add authenticated endpoints.
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRY_MINUTES=60
