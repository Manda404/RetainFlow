# RetainFlow environment template.
# Copy this file to `.env` for local development.

# ---------------------------------------------------------------------------
# PostgreSQL local source system
# ---------------------------------------------------------------------------

RETAINFLOW_POSTGRES_DSN=postgresql://retainflow:retainflow@localhost:55432/retainflow
POSTGRES_DB=retainflow
POSTGRES_USER=retainflow
POSTGRES_PASSWORD=retainflow
POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# Synthetic data generation
# ---------------------------------------------------------------------------

# Global seed used to make generation as reproducible as possible.
RETAINFLOW_SEED=42

# Default local/test dataset size.
# Start small, then increase to 100000, 500000, or 1000000 once pipelines are
# stable on Databricks.
RETAINFLOW_N_CUSTOMERS=10000
RETAINFLOW_CSV_DIR=data/raw/retainflow_csv

# Generated history covers 2020-01-01 to 2026-06-30.
RETAINFLOW_HISTORY_START_DATE=2020-01-01
RETAINFLOW_HISTORY_END_DATE=2026-06-30

# Pipeline mode.
# reset: rebuild the environment from scratch.
# incremental: reserved for later daily batch simulation.
RETAINFLOW_MODE=reset

# ---------------------------------------------------------------------------
# MLflow central tracking
# ---------------------------------------------------------------------------

# Use the central MLflow path or server you already have.
# Examples:
# MLFLOW_TRACKING_URI=file:///Users/surelmanda/path/to/mlflow
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_URI=

# ---------------------------------------------------------------------------
# Databricks legacy / later ML execution
# ---------------------------------------------------------------------------

# Databricks is no longer used for table creation in the first project step.
# Keep these only for later experiments if you decide to run model jobs there.
DATABRICKS_HOST=
DATABRICKS_WORKSPACE_ID=
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=
DATABRICKS_SQL_WAREHOUSE_ID=
